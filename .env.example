# Mattermost server base URL (http:// or https://).
KARMABOT_MATTERMOST_URL=https://mattermost.example.com

# Bot account personal access token (System Console → Integrations → Bot Accounts).
KARMABOT_MATTERMOST_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Database backend: sqlite (default) | postgres.
KARMABOT_DB_DRIVER=sqlite

# SQLite database location (directory is created if missing); used when
# KARMABOT_DB_DRIVER=sqlite.
KARMABOT_DB_PATH=./data/karmabot.db

# PostgreSQL connection string; required when KARMABOT_DB_DRIVER=postgres.
# KARMABOT_DB_DSN=postgres://user:password@localhost:5432/karmabot?sslmode=disable

# debug | info | warn | error
KARMABOT_LOG_LEVEL=info

# Reply language: en (default) | ru
KARMABOT_LANGUAGE=en

# Daily karma limits per giver, per channel: total per day and max to one
# person. 0 = unlimited. When both are set, per-target must not exceed
# total.
KARMABOT_DAILY_TOTAL_LIMIT=5
KARMABOT_DAILY_PER_TARGET_LIMIT=2

# Karma period length in days: the scoreboard resets every N days at
# 00:00 UTC.
KARMABOT_PERIOD_DAYS=7

# Mattermost username of the bot admin, who can run admin commands
# (e.g. `@karmabot status`). Unset disables admin commands.
# KARMABOT_ADMIN_USERNAME=admin
