# Mattermost server base URL (http:// or https://).
KARMABOT_MATTERMOST_URL=https://mattermost.example.com

# Bot account personal access token (System Console → Integrations → Bot Accounts).
KARMABOT_MATTERMOST_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# SQLite database location (directory is created if missing).
KARMABOT_DB_PATH=./data/karmabot.db

# debug | info | warn | error
KARMABOT_LOG_LEVEL=info
